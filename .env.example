# Copy this file to .env and restart the server. Every value is optional.

# GitHub token (no scopes needed for public repositories). Raises the limit from 60 to 5,000 requests per hour
# and lets you analyse your own private repositories. Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Language model for model-written summaries and answers. Without one, RepoLens still works (extractive mode).
# Option 1: Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Option 2: any OpenAI-compatible service, including a free local model with Ollama
# (for Ollama: OPENAI_BASE_URL=http://localhost:11434/v1 and OPENAI_MODEL=llama3.1, no key needed)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Force a provider: anthropic | openai | none
LLM_PROVIDER=

# Analysis limits
MAX_FILES=250
MAX_FILE_BYTES=200000
FETCH_CONCURRENCY=8

# Set to 0 to turn off the OSV.dev dependency vulnerability check
OSV=1
# Set to 0 to hide file:line locations of server bugs in error messages
DEBUG=1
PORT=8787
